{
  "name": "kōjō — workout log",
  "short_name": "kōjō",
  "description": "Build your own workouts, log them fast, watch the numbers climb.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0e1014",
  "theme_color": "#0e1014",
  "categories": ["health", "fitness", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start a workout",
      "short_name": "Start",
      "url": "/workouts",
      "description": "Pick a template and start logging"
    },
    {
      "name": "Progress",
      "short_name": "Progress",
      "url": "/progress",
      "description": "Charts and personal bests"
    }
  ]
}
